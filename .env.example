# Required — from your Regul8 / Base44 app
REGUL8_APP_ID=

# Required — Regul8 user credentials (same as API reference)
REGUL8_USER_EMAIL=
REGUL8_USER_PASSWORD=

# Optional — defaults to https://base44.app
# REGUL8_SERVER_URL=https://base44.app

# Optional — your deployed app root (e.g. https://your-app.base44.app); passed to the SDK as appBaseUrl when set
# REGUL8_APP_BASE_URL=
